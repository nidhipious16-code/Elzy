# Supabase project (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Meta (Facebook / Instagram lead ads and WhatsApp Business Cloud API)
META_APP_SECRET=
META_VERIFY_TOKEN=choose-a-long-random-string
META_PAGE_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Country code added to 10-digit mobile numbers
DEFAULT_COUNTRY_CODE=91
LEAD_FORM_ALLOWED_ORIGINS=https://www.example.com

# One-time code for the /setup page that creates the first admin. Remove it after setup.
SETUP_CODE=
